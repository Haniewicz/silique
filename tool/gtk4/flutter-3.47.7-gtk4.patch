+static GdkTexture* acquire_memory_texture(FlCompositorOpenGL* self,
+                                          FlFramebuffer* framebuffer) {
+  g_return_val_if_fail(framebuffer != nullptr, nullptr);
+  g_return_val_if_fail(self->pixels != nullptr, nullptr);
