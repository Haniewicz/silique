+#if GTK_CHECK_VERSION(4, 12, 0)
+  return gdk_surface_get_scale(surface);
+#else
+  return static_cast<double>(gdk_surface_get_scale_factor(surface));
+#endif
+}
+
+static inline gint fl_gtk_surface_get_width(FlGdkSurface* surface) {
+  gint width = GPOINTER_TO_INT(g_object_get_data(G_OBJECT(surface), "flutter-content-width"));
+  return width > 0 ? width : gdk_surface_get_width(surface);
+}
+
+static inline gint fl_gtk_surface_get_height(FlGdkSurface* surface) {
+  gint height = GPOINTER_TO_INT(g_object_get_data(G_OBJECT(surface), "flutter-content-height"));
+  return height > 0 ? height : gdk_surface_get_height(surface);
+}
+
+// Records where the Flutter content sits inside the toplevel GdkSurface.
+//
+// A GTK4 surface includes both the CSD border (the surface transform) and the
+// GtkHeaderBar, while Flutter renders into the content widget only. Measured
+// layout of a 1280x720 surface holding a 1270x664 content frame:
+//   render area inside the window widget:   point = (0, 46)    [header bar]
+//   window widget inside the surface:       transform = (5, 5) [CSD border]
+// so the content origin in surface coordinates is point + transform = (5, 51),
+// and 51 + 664 + 5 = 720 matches the surface height. Using point - transform
+// shifted every pointer event 10 px right and 10 px down, which the owner
+// reported as buttons reacting only when the cursor is above them.
+static inline void fl_gtk_surface_update_content_offset(
+    GtkWidget* content,
+    FlGdkSurface* surface) {
+  GtkNative* native = gtk_widget_get_native(content);
+  graphene_point_t origin = GRAPHENE_POINT_INIT(0, 0), point;
+  if (native == nullptr ||
+      !gtk_widget_compute_point(content, GTK_WIDGET(native), &origin, &point)) {
+    return;
+  }
+  double transform_x = 0.0, transform_y = 0.0;
+  gtk_native_get_surface_transform(native, &transform_x, &transform_y);
+  auto* offset = g_new(graphene_point_t, 1);
+  *offset = GRAPHENE_POINT_INIT(static_cast<float>(point.x + transform_x),
+                                static_cast<float>(point.y + transform_y));
+  g_object_set_data_full(G_OBJECT(surface), "flutter-content-offset", offset,
+                         g_free);
+}
+
+// GTK4 events use the toplevel surface, including client-side decorations.
+// Flutter receives positions in its content widget, excluding native chrome.
+static inline gboolean fl_gtk_event_get_view_position(GdkEvent* event,
+                                                     gdouble* x, gdouble* y) {
+  gboolean valid = gdk_event_get_position(event, x, y);
+  GdkSurface* surface = gdk_event_get_surface(event);
+  // GTK4 scroll events may have no position (NaN). Query the seat pointer,
+  // not the event source device: X11 slave devices cannot answer XIQueryPointer.
+  if ((!valid || !std::isfinite(*x) || !std::isfinite(*y)) &&
+      gdk_event_get_event_type(event) == GDK_SCROLL && surface != nullptr) {
+    GdkSeat* seat = gdk_event_get_seat(event);
+    GdkDevice* pointer = seat != nullptr ? gdk_seat_get_pointer(seat) : nullptr;
+    GdkModifierType modifiers;
+    valid = pointer != nullptr && gdk_surface_get_device_position(
+        surface, pointer, x, y, &modifiers);
+  }
+  if (!valid || !std::isfinite(*x) || !std::isfinite(*y)) return FALSE;
+  auto* offset = surface ? static_cast<graphene_point_t*>(g_object_get_data(
+      G_OBJECT(surface), "flutter-content-offset")) : nullptr;
+  if (offset != nullptr) {
+    *x -= offset->x;
+    *y -= offset->y;
+  }
+  return valid;
+}
