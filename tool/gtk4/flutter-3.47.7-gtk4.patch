+      cairo_format_stride_for_width(CAIRO_FORMAT_ARGB32, width);
+  g_autoptr(GBytes) bytes = g_bytes_new(self->pixels, stride * height);
+  return gdk_memory_texture_new(width, height, GDK_MEMORY_DEFAULT, bytes,
+                                stride);
