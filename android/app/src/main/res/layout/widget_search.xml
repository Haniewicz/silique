<?xml version="1.0" encoding="utf-8"?>
<!-- A small floating card: the window around it is transparent and only dimmed,
     while this card stays fully opaque so nothing behind it can be read. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_search_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/widget_surface"
    android:clickable="true"
    android:elevation="8dp">

    <EditText
        android:id="@+id/widget_query"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:hint="@string/widget_search_hint"
        android:textColor="@color/silique_on_surface"
        android:textColorHint="@color/silique_muted"
        android:background="@drawable/widget_row_background"
        android:inputType="text|textNoSuggestions"
        android:imeOptions="actionSearch|flagNoPersonalizedLearning"
        android:importantForAutofill="no"
        android:singleLine="true"/>

    <TextView
        android:id="@+id/widget_search_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="4dp"
        android:paddingStart="4dp"
        android:textColor="@color/silique_muted"
        android:textSize="12sp"
        android:visibility="gone"/>

    <ListView
        android:id="@+id/widget_results"
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:layout_marginTop="8dp"
        android:divider="@color/silique_line"
        android:dividerHeight="1dp"
        android:scrollbars="none"/>
</LinearLayout>
